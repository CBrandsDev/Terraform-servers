#cloud-config

# Configuração de acesso SSH e ip da maquina virtual
ssh_pwauth: true
chpasswd:
  list: |
    sysadmin:SenhaSegura 
  expire: false

users:
  - name: sysadmin
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC #Cole sua chave SSH pública aqui

network:
  version: 2
  ethernets:
    eth0:
      dhcp4: false
      addresses:
        - 192.168.x.x/24  # Atenção: Ajuste para um ip da sua rede
      routes:
        - to: default
          via: 192.168.x.x  # Gateway da rede 
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
